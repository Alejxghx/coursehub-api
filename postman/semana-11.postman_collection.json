    {
      "name": "03 Matriz de autorización y componentes transversales",
      "item": [
        {
          "name": "Perfil muestra el rol actual",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenOwner}}",
                  "type": "string"
                }
              ]
            },
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
                  "pm.test('Rol docente',()=>pm.expect(pm.response.json().role).to.eql('teacher'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear curso como propietario",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/courses",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenOwner}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Curso matriz semana 11\",\n  \"level\": \"beginner\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('courseId',String(pm.response.json().id));pm.collectionVariables.set('ownerId',String(pm.response.json().createdByUserId));"
                ]
              }
            }
          ]
        },
