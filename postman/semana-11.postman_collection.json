    {
      "name": "02 Login tras asignación local de roles - 4 intentos",
      "item": [
        {
          "name": "Login Student - capturar Visualize",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student11@example.com\",\n  \"password\": {{practicePasswordJson}}\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
                  "const body=pm.response.json();pm.environment.set('tokenStudent',body.accessToken);",
                  "pm.visualizer.set('<h3>Login correcto</h3><p>Token completo omitido</p><pre>{{user}}</pre>',{user:JSON.stringify(body.user,null,2)});"
                ]
              }
            }
          ]
        },
