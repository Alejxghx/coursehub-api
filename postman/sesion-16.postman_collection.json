        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \" {{uppercaseEmail}} \",\n  \"password\": {{practicePasswordJson}}\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Solo datos seguros del usuario', () => pm.expect(Object.keys(pm.response.json()).sort()).to.eql(['createdAt', 'email', 'id']));",
              "pm.test('Misma cuenta que en el registro', () => pm.expect(pm.response.json()).to.eql(JSON.parse(pm.collectionVariables.get('registeredUser'))));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 — Contraseña incorrecta: 401",
