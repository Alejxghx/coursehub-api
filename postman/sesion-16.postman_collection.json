          "raw": "{\n  \"email\": \"{{registrationEmail}}\",\n  \"password\": \"{{wrongPassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('wrongPassword', 'incorrecta-' + pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
              "pm.test('Error genérico', () => pm.expect(pm.response.json()).to.eql({ statusCode: 401, message: 'Invalid credentials', error: 'Unauthorized' }));",
              "pm.collectionVariables.set('failedLoginResponse', JSON.stringify(pm.response.json()));"
            ]
          }
        }
      ]
    },
